# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — MVP PREVISÃO CAFÉ ARÁBICA
# ==============================================================================

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cafe_previsao
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Janela Histórica e Controle de Poda
HISTORICAL_YEARS=9
MAX_PRUNE_YEARS=2
DATASET_MIN_DAYS=1096
# Trava obrigatória para execução de produção contra divergências de janela
CONFIRM_HISTORICAL_WINDOW=true

# Horizontes de Previsão
FORECAST_HORIZONS=7,15,30,90

# Timezone e Execução
TIMEZONE=America/Sao_Paulo
UPDATE_TIME=00:00

# Agro.br / Modo de Ingestão
# Opções: "real" (chama bibliotecas e APIs) ou "simulated" (mock reprodutível e arquivos locais)
AGROBR_MODE=simulated
AGROBR_TIMEOUT_SECONDS=60
AGROBR_MAX_RETRIES=3

# Caminhos Locais
SQLITE_SOURCE_PATH=base/cafe_centro_oeste_mg.db
MANUAL_DATA_DIR=base/dados_manuais

# Log Level
LOG_LEVEL=INFO

# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — MVP PREVISÃO CAFÉ ARÁBICA
# ==============================================================================

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cafe_previsao
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
# URL completa do banco do pipeline. Quando definida, tem precedência sobre
# DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD na conexão do pipeline.
# PIPELINE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafe_previsao
# Chave do advisory lock que serializa os ciclos do pipeline no PostgreSQL.
ADVISORY_LOCK_KEY=84729103

# Janela Histórica e Controle de Poda
HISTORICAL_YEARS=9
MAX_PRUNE_YEARS=2
DATASET_MIN_DAYS=1096
# Trava obrigatória para execução de produção contra divergências de janela
CONFIRM_HISTORICAL_WINDOW=true

# Horizontes de Previsão
FORECAST_HORIZONS=7,15,30,90

# Timezone e Execução
TIMEZONE=America/Sao_Paulo
UPDATE_TIME=00:00
# Horários dos jobs de pós-fechamento e pré-abertura (usados com --schedule)
AFTER_CLOSE_TIME=19:00
BEFORE_OPEN_TIME=08:00
# Novas tentativas de um job após erro inesperado, e espera entre elas
JOB_MAX_RETRIES=2
JOB_RETRY_WAIT_SECONDS=60

# Agendador embutido (APScheduler, modo --schedule)
SCHEDULER_ENABLED=true
# Id estável do job no agendador; padrão: o nome do job. Só vale com um único
# job por processo (válido para `python -m jobs.X --schedule`).
# SCHEDULER_JOB_ID=update_daily
# Tolerância (segundos) para um disparo atrasado ainda rodar uma vez (máquina
# dormiu, reinício). Além dela o disparo é registrado como perdido e não roda
# sozinho; o próximo horário normal assume.
MISFIRE_GRACE_SECONDS=3600

# Agro.br / Modo de Ingestão
# Opções: "real" (CEPEA, BCB, B3 e NASA POWER via agrobr; ICE via Yahoo Finance)
#         "simulated" (preços dos CSVs locais; câmbio, futuros e clima fabricados, só para testes)
AGROBR_MODE=simulated
AGROBR_TIMEOUT_SECONDS=60
AGROBR_MAX_RETRIES=3
# Tenta baixar a série histórica do CEPEA a cada coleta real. Desligado por padrão: o site
# recusa o download automático (HTTP 403). Com false, vale o CSV de MANUAL_DATA_DIR
# (atualize-o com `python -m src.cepea_series --importar`), completado pelo agrobr.
CEPEA_AUTO_DOWNLOAD=false
# Cache em disco da coleta real (hoje: ajustes diários da B3, lentos de baixar)
COLLECTION_CACHE_DIR=.cache/coleta
# Dias recoletados a cada job agendado. 0 = a janela histórica inteira (necessário na
# primeira carga). Depois dela, um valor como 45 evita regravar anos de histórico em raw
# todo dia; revisões mais antigas que isso passam a exigir jobs.reprocess_period.
COLLECTION_WINDOW_DAYS=0

# Caminhos Locais
SQLITE_SOURCE_PATH=base/cafe_centro_oeste_mg.db
MANUAL_DATA_DIR=base/dados_manuais

# Log Level
LOG_LEVEL=INFO
